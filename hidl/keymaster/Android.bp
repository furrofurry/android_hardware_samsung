//
// Samsung Keymaster 4.0
// OrangeFox 14.1 compatible
//

cc_binary {
    name: "android.hardware.keymaster@4.0-service.samsung",

    init_rc: [
        "android.hardware.keymaster@4.0-service.samsung.rc",
    ],

    srcs: [
        "service.cpp",
    ],

    shared_libs: [
        "android.hardware.keymaster@4.0",
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",

        // Samsung Exynos 990 Keymaster implementation.
        // Must be linked before libkeymaster4.
        "libskeymaster4device",

        "libkeymaster4",
    ],

    relative_install_path: "hw",

    owner: "samsung",
    vendor: true,
}
